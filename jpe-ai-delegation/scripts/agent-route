#!/usr/bin/env bash
set -euo pipefail

fail() {
  local status=$1
  shift
  printf 'agent-route: %s\n' "$*" >&2
  exit "$status"
}

if (($# == 0)); then
  fail 2 'usage: agent-route <code|private|other>'
fi

kind=$1
shift

(($# == 0)) || fail 2 'usage: agent-route <code|private|other>'

command -v jq >/dev/null 2>&1 || fail 1 'jq is required'

plugin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
ladder_file="$plugin_dir/skills/delegation-ladder/ladder.json"
[[ -r $ladder_file ]] || fail 1 'ladder data is not readable'

if ! jq -e --arg kind "$kind" '.kinds | has($kind)' "$ladder_file" >/dev/null 2>&1; then
  kind_display=${kind//$'\n'/ }
  kind_display=${kind_display//$'\r'/ }
  fail 2 "unknown kind: $kind_display"
fi

if ! jq -e --arg kind "$kind" '.kinds[$kind] | (.visibility == "public" or .visibility == "private") and (.rungs | type == "array" and length > 0)' "$ladder_file" >/dev/null 2>&1; then
  fail 1 'invalid ladder data'
fi

if [[ ${AGENT_ROUTE_CODEX_QUOTA+x} ]]; then
  codex_quota=$AGENT_ROUTE_CODEX_QUOTA
  case "$codex_quota" in
    available|exhausted) ;;
    *) fail 2 'AGENT_ROUTE_CODEX_QUOTA must be available or exhausted' ;;
  esac
elif codex-quota >/dev/null 2>&1; then
  codex_quota=available
else
  codex_quota=exhausted
fi

while IFS=$'\t' read -r executor gate; do
  case "$gate" in
    codex)
      [[ $codex_quota == available ]] || continue
      ;;
    always) ;;
    # The lead sets this only after a private repo passes its property and classify-payload gates.
    allowlisted)
      [[ ${AGENT_ROUTE_SANDBOX_ALLOWLISTED:-} == yes ]] || continue
      ;;
    *) fail 1 'invalid ladder gate' ;;
  esac

  printf '%s\n' "$executor"
  exit 0
done < <(jq -r --arg kind "$kind" '.kinds[$kind].rungs[] | [.name, .gate] | @tsv' "$ladder_file")

fail 1 'no eligible executor'
